{
  "name": "lazyhardwork-chatbot",
  "version": "2.0.0-dev",
  "description": "Lay v2 — LazyHardWork LINE OA assistant (structured replies, Flex cards, KB pack from the vault, Discord relay)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src --watch .env --ext js,json,env src/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "scenarios": "node tests/run-scenarios.js",
    "kb:build": "node scripts/kb-build.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@line/bot-sdk": "^9.4.0",
    "axios": "^1.7.2",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^4.3.2",
    "openai": "^4.97.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
