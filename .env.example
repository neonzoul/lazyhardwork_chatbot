# LINE OA
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Business hours (24h format, Asia/Bangkok)
BUSINESS_HOURS_START=13
BUSINESS_HOURS_END=22

# Discord webhooks
DISCORD_LEADS_WEBHOOK=https://discord.com/api/webhooks/...
DISCORD_CRM_WEBHOOK=https://discord.com/api/webhooks/...

# LLM — provider is OpenRouter (doc/llm.md). Model per task is in src/agents.config.js; LLM_MODEL_* overrides it.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# LLM_MODEL_LAY_REPLY=
# LLM_MODEL_LAY_REPAIR=
# LLM_MODEL_DEMO_REPLY=
# LLM_MODEL_QA_JUDGE=
# legacy (v1, OpenAI direct) — not used by v2
OPENAI_API_KEY=

# Contact (injected into system prompt — never hard-code)
CONTACT_PHONE=0955691674
CONTACT_EMAIL=naruecha.ps@hotmail.com

# Fastwork profile URL (used in portfolio reply)
FASTWORK_URL=https://fastwork.co/byob/lfs1MwikX7?openExternalBrowser=1&source=byob

# Admin endpoint secret (GET /admin/resume?secret=xxx&userId=Uxxxxx)
ADMIN_SECRET=change-this-to-something-secret

# Server
PORT=3000

# --- Lay v2 (2026-10-17) ---
